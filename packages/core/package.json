{
  "name": "@falcondev-oss/lang-core",
  "type": "module",
  "version": "0.1.0",
  "description": "Type-safe i18n where the English source text is the key. Framework-agnostic core.",
  "license": "MIT",
  "repository": "github:falcondev-oss/lang",
  "bugs": {
    "url": "https://github.com/falcondev-oss/lang/issues"
  },
  "keywords": [
    "i18n",
    "translation",
    "localization",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsdown",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "type-fest": "^5.10.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
