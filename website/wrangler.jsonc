{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docs-lang",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "preview_urls": true,
  "routes": [{ "pattern": "lang.falcondev.io", "custom_domain": true }],
  // branch builds deploy a preview with `wrangler preview` (Workers Builds)
  "previews": {},
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
}
