---
/** Auto, light or dark as a small segmented switch. Same storage key as Starlight's own picker. */
const t = Astro.locals.t
const icon = (body: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`
const options = [
  { value: 'auto', label: t('themeSelect.auto'), svg: icon('<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>') },
  { value: 'light', label: t('themeSelect.light'), svg: icon('<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>') },
  { value: 'dark', label: t('themeSelect.dark'), svg: icon('<path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"/>') },
]
---

<lang-theme-select role="radiogroup" aria-label={t('themeSelect.accessibleLabel')}>
  {options.map((o) => <button type="button" role="radio" aria-checked="false" data-value={o.value} aria-label={o.label} title={o.label} set:html={o.svg} />)}
</lang-theme-select>

{/* inlined, so the right button is pressed before the first paint */}
<script is:inline>
  ;(() => {
    const theme = localStorage.getItem('starlight-theme') || 'auto'
    for (const b of document.querySelectorAll('lang-theme-select button'))
      b.setAttribute('aria-checked', String(b.dataset.value === theme))
  })()
</script>

<script>
  type Theme = 'auto' | 'light' | 'dark'
  const key = 'starlight-theme'
  const parse = (v: unknown): Theme => (v === 'light' || v === 'dark' ? v : 'auto')
  const load = () => parse(localStorage.getItem(key))
  const system = () => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')

  function apply(theme: Theme) {
    document.documentElement.dataset['theme'] = theme === 'auto' ? system() : theme
    localStorage.setItem(key, theme === 'auto' ? '' : theme)
    for (const b of document.querySelectorAll<HTMLElement>('lang-theme-select button'))
      b.setAttribute('aria-checked', String(b.dataset['value'] === theme))
  }
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (load() === 'auto') apply('auto')
  })

  class ThemeSelect extends HTMLElement {
    connectedCallback() {
      this.addEventListener('click', (e) => {
        const b = (e.target as Element).closest<HTMLElement>('button')
        if (b) apply(parse(b.dataset['value']))
      })
      // arrow keys move between the options, like a radio group
      this.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return
        const buttons = [...this.querySelectorAll<HTMLElement>('button')]
        const i = buttons.indexOf(document.activeElement as HTMLElement)
        const next = buttons[(i + (e.key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length]
        next?.focus()
        if (next) apply(parse(next.dataset['value']))
      })
    }
  }
  customElements.define('lang-theme-select', ThemeSelect)
</script>

<style>
  lang-theme-select {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 999px;
  }
  button {
    all: unset;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.5rem;
    border-radius: 999px;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  button:hover {
    color: var(--sl-color-white);
  }
  button[aria-checked='true'] {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  button:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }
  button :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
  }
</style>
