---
/** The current language as a compact pill that opens a small menu of real links. */
import { LABELS, lang, prefix, type Language } from '../i18n/lang'

const current = (Astro.locals.starlightRoute.lang ?? 'en') as Language
// the same page in another language: strip this page's prefix, add the other one
const path = Astro.url.pathname.replace(/^\/(?:de|es|ja|pl)(?=\/|$)/, '') || '/'
const href = (l: Language) => (l === 'en' ? path : `${prefix(l)}${path === '/' ? '' : path}`)
const label = Astro.locals.t('languageSelect.accessibleLabel')
---

<lang-language-select>
  <button type="button" aria-haspopup="true" aria-expanded="false" aria-label={`${label}: ${LABELS[current]}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"></path>
    </svg>
    <span class="code">{current}</span>
    <svg class="caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>
  <ul class="menu" hidden>
    {
      lang.languages.map((l) => (
        <li>
          <a href={href(l)} hreflang={l} lang={l} aria-current={l === current ? 'page' : undefined}>
            <span>{LABELS[l]}</span>
            <code>{l}</code>
          </a>
        </li>
      ))
    }
  </ul>
</lang-language-select>

<script>
  class LanguageSelect extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button')!
      const menu = this.querySelector<HTMLElement>('.menu')!
      const links = () => [...menu.querySelectorAll<HTMLElement>('a')]
      const toggle = (open: boolean) => {
        menu.hidden = !open
        button.setAttribute('aria-expanded', String(open))
        if (!open) return
        // open upwards when there is no room below, e.g. in the mobile menu's footer
        this.classList.toggle('up', button.getBoundingClientRect().bottom + 240 > innerHeight)
        ;(menu.querySelector<HTMLElement>('[aria-current]') ?? links()[0])?.focus()
      }
      button.addEventListener('click', () => toggle(menu.hidden === true))
      document.addEventListener('click', (e) => {
        if (!this.contains(e.target as Node)) toggle(false)
      })
      this.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu.hidden !== true) {
          toggle(false)
          button.focus()
        }
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return
        e.preventDefault()
        if (menu.hidden === true) return toggle(true)
        const all = links()
        const i = all.indexOf(document.activeElement as HTMLElement)
        all[(i + (e.key === 'ArrowDown' ? 1 : -1) + all.length) % all.length]?.focus()
      })
    }
  }
  customElements.define('lang-language-select', LanguageSelect)
</script>

<style>
  lang-language-select {
    position: relative;
    display: inline-block;
  }
  button {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 1.75rem;
    padding: 0 0.5rem 0 0.6rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 999px;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  button:hover,
  button[aria-expanded='true'] {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-5);
  }
  button:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }
  svg {
    width: 0.9rem;
    height: 0.9rem;
  }
  .caret {
    width: 0.75rem;
    height: 0.75rem;
    transition: rotate 0.2s;
  }
  button[aria-expanded='true'] .caret {
    rotate: 180deg;
  }
  .code {
    font: 500 0.72rem/1 var(--sl-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    z-index: 20;
    min-width: 10.5rem;
    margin: 0;
    padding: 0.3rem;
    list-style: none;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.6rem;
    background: var(--sl-color-bg-nav);
    box-shadow: 0 16px 40px -16px rgb(0 0 0 / 0.5);
    animation: lang-menu-in 0.16s ease-out;
  }
  lang-language-select.up .menu {
    top: auto;
    bottom: calc(100% + 0.4rem);
  }
  .menu li {
    margin: 0;
  }
  .menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0.6rem;
    border-radius: 0.4rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-decoration: none;
    outline: none;
  }
  .menu a:is(:hover, :focus-visible) {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  .menu a[aria-current] {
    color: var(--sl-color-accent-high);
  }
  .menu code {
    font: 0.68rem var(--sl-font-mono);
    color: var(--sl-color-gray-4);
    text-transform: uppercase;
    background: none;
    padding: 0;
  }
  @keyframes lang-menu-in {
    from {
      opacity: 0;
      translate: 0 -4px;
    }
  }
</style>
